---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Tidbit from '../components/Tidbit.astro';
import HomeOverlays from '../components/HomeOverlays.astro';
import { projects, tidbits } from '../data/projects';

// Tidbits reveal a row (two items) at a time, like the live site
const tidbitRows = Array.from({ length: Math.ceil(tidbits.length / 2) }, (_, i) => tidbits.slice(i * 2, i * 2 + 2));
---
<Base>
  <Hero />

  <div class="content">
    <section aria-labelledby="featured">
      <h2 id="featured" class="t-section">Featured Projects ↓</h2>
      <div class="rows">
        {projects.map((row) => (
          <div class="row" data-reveal>
            {row.map((p) => <ProjectCard project={p} />)}
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="tidbits" class="tidbits">
      <h2 id="tidbits" class="t-section">Design Tidbits</h2>
      <div class="grid">
        {tidbitRows.map((row) => (
          <div class="tid-row" data-reveal>
            {row.map((t) => <Tidbit item={t} />)}
          </div>
        ))}
      </div>
    </section>
  </div>
  <HomeOverlays slot="overlays" />
</Base>

<style>
  .content {
    max-width: 1020px;
    margin: 0 auto;
    padding: 71px 0 100px;
    box-sizing: content-box;
  }
  h2 { margin-bottom: 24px; }
  .rows { display: flex; flex-direction: column; gap: 40px; }
  .row { display: flex; gap: 32px; }
  .tidbits { margin-top: 107px; }
  .grid { display: flex; flex-direction: column; gap: 32px; }
  .tid-row { display: grid; grid-template-columns: repeat(2, minmax(0, 485px)); column-gap: 50px; justify-content: space-between; }

  @media (max-width: 1199px) {
    .content { padding-left: 84px; padding-right: 84px; }
  }
  @media (max-width: 809px) {
    .content { padding: 48px 24px 64px; }
    .row { flex-direction: column; gap: 40px; }
    .tid-row { grid-template-columns: 1fr; row-gap: 32px; }
    .tidbits { margin-top: 80px; }
  }
</style>
