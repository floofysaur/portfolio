77, 77);font-weight:700;letter-spacing:-0.3px\">Face Swap</strong>: Seamlessly replace faces in photos or videos.</p></li><li style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\"><p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\"><strong style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);font-weight:700;letter-spacing:-0.3px\">Lip Sync</strong>: Make characters speak any audio.</p></li></ul>", "single": false}, {"t": "box", "w": 819, "h": 243, "flex": "row|24px|0px|center|center|nowrap", "kids": [{"t": "box", "w": 819, "h": 243, "flex": "column|0px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"reveal": 1, "t": "box", "w": 819, "h": 243, "flex": "row|0px|0px|center|center|nowrap", "clip": 1, "kids": [{"bg": "rgb(82, 4, 254)", "t": "box", "w": 5, "h": 243, "clip": 1, "kids": [], "empty": 1}, {"br": "0px 8px 8px 0px", "bg": "rgba(83, 4, 254, 0.05)", "t": "box", "w": 814, "h": 243, "flex": "row|24px|16px 16px 16px 24px|flex-start|flex-start|nowrap", "clip": 1, "kids": [{"t": "box", "w": 375, "h": 210, "flex": "column|24px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"id": "01-context-1", "t": "text", "w": 375, "h": 21, "html": "<h5 style=\"font-family:var(--mono);font-size:14px;line-height:21px;color:rgb(82, 4, 254)\">Try it out!</h5>", "fill": 1, "single": true}, {"t": "box", "w": 375, "h": 95, "flex": "column|10px|0px|center|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 375, "h": 95, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Swap your face with Magic Hour's Face Swap Feature! </p><p style=\"margin-top:5px;font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Note that this is the landing page version of the feature. This case study features the product flow o