254)\">RESEARCH &amp; PLANNING</h5>", "fill": 1, "single": true}, {"t": "text", "w": 600, "h": 38, "html": "<h3 style=\"font-family:var(--serif);font-size:24px;line-height:30px;color:rgb(0, 0, 0)\">Synthesizing preliminary user tests</h3>", "single": true}, {"t": "text", "w": 600, "h": 158, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">I first conducted a cognitive walkthrough of the initial product flow. My unfamiliarity with Magic Hour's platform as a new user helped me identify potential issues that led to early drop-offs, and UX confusions.<br>‍<br>Magic Hour already had a summary of previous usability tests including 12 screen-recorded users using the \"think aloud method and their transcripts. I noticed that the majority of user dissatisfaction came from one of the following pain points:</p>", "single": false}, {"br": "8px", "bg": "rgb(247, 243, 255)", "t": "box", "w": 819, "h": 110, "flex": "column|8px|24px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 771, "h": 62, "flex": "row|10px|0px|center|center|nowrap", "clip": 1, "kids": [{"br": "0px 10px 10px 0px", "t": "box", "w": 380, "h": 62, "flex": "row|16px|0px|center|center|nowrap", "clip": 1, "kids": [{"bg": "rgb(83, 5, 254)", "t": "box", "w": 3, "h": 62, "clip": 1, "kids": [], "empty": 1}, {"t": "box", "w": 361, "h": 62, "flex": "column|0px|4px 0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 361, "h": 32, "html": "<h5 style=\"font-family:var(--ui);font-size:32px;line-height:32px;color:rgb(0, 0, 0);font-weight:600\"><mark style=\"font-family:var(--ui);font-size:32px;line-height:32px;color:rgb(0, 0, 0);font-weight:600\">12 user tests</mark></h5>", "fill": 1, "single": true}, {"t": "text", "w": 361, "h": 22, "html": "<p style=\"font-family:var(--sans);font-size:14px;line-height:22.4px;color:rgb(138, 138, 138);font-style:italic;letter-spacing:-0.28px\"><em style=\"font-family:var(--sans);font-size:14px;line-height:22.4px;color:rgb(138, 138, 138);font-style:italic;letter-spacing:-0.28px\">Pre-recorded through usertesting.com </em></p>", "fill": 1, "single": true}]}]}, {"br": "0px 10px 10px 0px", "t": "box", "w": 381, "h": 62, "flex": "row|16px|0px|center|center|nowrap", "clip": 1, "kids": [{"bg": "rgb(83, 5, 254)", "t": "box", "w": 3, "h": 62, "clip": 1, "kids": [], "empty": 1}, {"t": "box", "w": 362, "h": 62, "flex": "column|0px|4px 0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 362, "h": 32, "html": "<h5 style=\"font-family:var(--ui);font-size:32px;line-height:32px;color:rgb(0, 0, 0);font-weight:600;text-transform:capitalize\"><mark style=\"font-family:var(--ui);font-size:32px;line-height:32px;color:rgb(0, 0, 0);font-weight:600;text-transform:capitalize\">4/12</mark></h5>", "fill": 1, "single": true}, {"t": "text", "w": 362, "h": 22, "html": "<p style=\"font-family:var(--sans);font-size:14px;line-height:22.4px;color:rgb(138, 138, 138);font-style:italic;letter-spacing:-0.28px\"><em style=\"font-family:var(--sans);font-size:14px;line-height:22.4px;color:rgb(138, 138, 138);font-style:italic;letter-spacing:-0.28px\">did not succed in creating a face swap video</em></p>", "fill": 1, "single": true}]}]}], "fill": 1, "stack": 1}], "fill": 1}, {"t": "box", "w": 819, "h": 135, "flex": "row|10px|0px 0px 10px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 266, "h": 104, "flex": "row|0px|8px 16px 8px 20px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 230, "h": 88, "flex": "column|4px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 230, "h": 21, "html": "<h5 style=\"font-family:var(--mono);font-size:14px;line-height:21px;color:rgb(150, 150, 150)\">Confusing UX</h5>", "fill": 1, "single": true}, {"t": "text", "w": 230, "h": 63, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Features such as \"multi-face swap\" and uploading a Youtube video are not immediately obvious to the user.</p>", "fill": 1, "single": false}], "fill": 1}]}, {"t": "box", "w": 266, "h": 104, "flex": "row|0px|8px 16px 8px 20px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 230, "h": 88, "flex": "column|4px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 230, "h": 21, "html": "<h5 style=\"font-family:var(--mono);font-size:14px;line-height:21px;color:rgb(184, 184, 184)\">Lack of Cost Transparency</h5>", "fill": 1, "single": true}, {"t": "text", "w": 230, "h": 63, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Users are only told about potential price warnings after they have completed the entire flow.</p>", "fill": 1, "single": false}], "fill": 1}]}, {"t": "box", "w": 266, "h": 125, "flex": "row|0px|8px 16px 8px 20px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 230, "h": 109, "flex": "column|4px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 230, "h": 42, "html": "<h5 style=\"font-family:var(--mono);font-size:14px;line-height:21px;color:rgb(184, 184, 184)\">Lack of readily available assets</h5>", "fill": 1, "single": false}, {"t": "text", "w": 230, "h": 63, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Many users did not have a clear headshot on their device that could be used to swap faces.</p>", "fill": 1, "single": false}], "fill": 1}]}], "fill": 1, "stack": 1}, {"reveal": 1, "t": "box", "w": 737, "h": 43, "flex": "row|0px|0px|center|center|nowrap", "clip": 1, "kids": [{"bg": "rgb(83, 4, 254)", "t": "box", "w": 5, "h": 43, "clip": 1, "kids": [], "empty": 1}, {"br": "0px 5px 5px 0px", "bg": "rgba(83, 4, 254, 0.05)", "t": "box", "w": 732, "h": 43, "flex": "row|20px|10px|center|flex-start|nowrap", "clip": 1, "kids": [{"t": "text", "w": 712, "h": 23, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">“Am I missing something about how much [frames] you’re supposed to get?” - Magic Hour user</p>", "fill": 1, "single": true}]}]}], "fill": 1}, {"t": "box", "w": 600, "h": 130, "flex": "column|8px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 209, "h": 38, "html": "<h3 style=\"font-family:var(--serif);font-size:24px;line-height:30px;color:rgb(0, 0, 0)\">Creating a gameplan</h3>", "single": true}, {"t": "text", "w": 600, "h": 84, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">This was my first project as a remote designer. I was concerned with a/b testing and the amount of additional work it would take for Runbo and David to implement. Although Runbo said a/b testing wasn't as strenous and I thought, we decided to go with creating Figma prototypes and conducting user tests using my prototypes.</p>", "fill": 1, "single": false}]}, {"t": "box", "w": 819, "h": 187, "flex": "column|8px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 299, "h": 38, "html": "<h3 style=\"font-family:var(--serif);font-size:24px;line-height:30px;color:rgb(0, 0, 0)\">Early stage design constraints</h3>", "single": true}, {"t": "box", "w": 819, "h": 141, "flex": "row|10px|16px 0px 0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 404, "h": 104, "flex": "row|0px|8px 16px 8px 20px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 368, "h": 88, "flex": "column|4px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 368, "h": 21, "html": "<h5 style=\"font-family:var(--mono);font-size:14px;line-height:21px;color:rgb(150, 150, 150)\">GPU Limitations</h5>", "fill": 1, "single": true}, {"t": "text", "w": 368, "h": 63, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Swapping multiple faces in a video is useful, but very GPU intensive. HMW design a flow that only allows high intent users to swap multiple faces?</p>", "fill": 1, "single": false}], "fill": 1}]}, {"t": "box", "w": 405, "h": 125, "flex": "row|0px|8px 16px 8px 20px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 369, "h": 109, "flex": "column|4px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 369, "h": 21, "html": "<h5 style=\"font-family:var(--mono);font-size:14px;line-height:21px;color:rgb(150, 150, 150)\">Catering to professionals and casual users</h5>", "fill": 1, "single": true}, {"t": "text", "w": 369, "h": 84, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Magic Hour is used by beginners and professionals. What is the minimum we can show the user to ensure they get what they’re looking for, while still preserving advanced features but only showing them for the users who want it?</p>", "fill": 1, "single": false}], "fill": 1}]}], "fill": 1, "stack": 1}], "fill": 1}], "fill": 1}, {"reveal": 1, "t": "box", "w": 819, "h": 3435, "flex": "column|32px|0px|center|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 819, "h": 774, "flex": "column|8px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"id": "04-prorotype", "t": "text", "w": 819, "h": 21, "html": "<h5 style=\"font-family:var(--mono);font-size:14px;line-height:21px;color:rgb(82, 4, 254)\">PROTOTYPE, TEST, EVALUATE, REPEAT</h5>", "fill": 1, "single": true}, {"t": "text", "w": 819, "h": 38, "html": "<h3 style=\"font-family:var(--serif);font-size:24px;line-height:30px;color:rgb(0, 0, 0)\">Reducing it all to one page</h3>", "fill": 1, "single": true}, {"t": "text", "w": 600, "h": 141, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">My first intuition was to reduce the product flow to a single page. Having all the information clearly laid out gives a good idea of how many steps are next, and reduces unnecessary clicking. I made two low fidelity prototypes, one with each step as a toggle and the other without.</p><p style=\"margin-top:15px;font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">A potential concern with the collapsed dropdowns is that it could lead to slightly higher drop-off, as the user has to click a tab before they proceed, as opposed to the initial design where they would see the upload box immediately.</p>", "single": false}, {"t": "box", "w": 819, "h": 550, "kids": [{"t": "img", "w": 819, "h": 550, "src": "/images/cs/gFPkDfKBHLmTJZpSyMZIU8Ces.webp", "fit": "cover", "pos": "50% 50%", "fill": 1}]}], "fill": 1}, {"t": "box", "w": 819, "h": 652, "flex": "column|8px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 600, "h": 38, "html": "<h3 style=\"font-family:var(--serif);font-size:24px;line-height:30px;color:rgb(0, 0, 0)\">Most users struggle to find available portrait photos</h3>", "single": true}, {"t": "text", "w": 600, "h": 63, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">I created an assets panel with curated face portraits and recently uploaded photos to reduce friction in the face swap flow. A/B testing showed an 80% reduction in user drop-off, and the assets doubled as examples that helped users understand which photos work best.</p>", "single": false}, {"br": "5px", "t": "box", "w": 819, "h": 535, "kids": [{"br": "5px", "t": "img", "w": 819, "h": 535, "src": "/images/cs/EHlOdrTKxuLmxzYsKB1rFoGaFp4.webp", "fit": "cover", "pos": "50% 50%", "abs": [0, 0]}], "frame": 1}], "fill": 1}, {"t": "box", "w": 819, "h": 1945, "flex": "column|8px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 819, "h": 35, "html": "<h3 style=\"font-family:var(--serif-alt);font-size:32px;line-height:35.2px;color:rgb(0, 0, 0)\"><mark style=\"font-family:var(--serif-alt);font-size:32px;line-height:35.2px;color:rgb(0, 0, 0)\">What's a \"<em style=\"font-family:var(--serif-alt);font-size:32px;line-height:35.2px;color:rgb(0, 0, 0);font-style:italic\">multi-face swap</em>\"?</mark></h3>", "fill": 1, "single": true}, {"reveal": 1, "t": "box", "w": 737, "h": 65, "flex": "row|0px|0px|center|center|nowrap", "clip": 1, "kids": [{"bg": "rgb(83, 4, 254)", "t": "box", "w": 3, "h": 65, "clip": 1, "kids": [], "empty": 1}, {"br": "0px 5px 5px 0px", "bg": "rgba(83, 4, 254, 0.05)", "t": "box", "w": 735, "h": 65, "flex": "row|20px|10px|center|flex-start|nowrap", "clip": 1, "kids": [{"t": "text", "w": 715, "h": 45, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">How might we increase the number of people using the \"Multi-face Swap\" option while being efficient with GPU&nbsp;usage?</p>", "fill": 1, "single": false}]}]}, {"t": "text", "w": 600, "h": 173, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">When face swaping, users have two options:</p><ol style=\"margin-top:5px;font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\"><li style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\"><p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\"><strong style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);font-weight:700;letter-spacing:-0.3px\">Swap all faces</strong>: Upload one photo and replace all faces in the video with that once photo</p></li><li style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\"><p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\"><strong style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);font-weight:700;letter-spacing:-0.3px\">Multi face swap</strong>: Select specific faces to swap with other faces</p></li></ol><p style=\"margin-top:15px;font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Only 2% of users who created a video used the \"Multi-face Swap\" function. We felt this percentage was disproportionately low. I suspected it was because the term \"Multi-face Swap\" doesn't make its own function apparently clear.</p>", "single": false}, {"t": "box", "w": 819, "h": 408, "kids": [{"t": "img", "w": 819, "h": 408, "src": "/images/cs/BRJGOwPX6qa8F0rBHavLgrTCUE.webp", "fit": "cover", "pos": "50% 50%", "fill": 1}]}, {"t": "text", "w": 600, "h": 126, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">I initially removed “Swap All Faces” in favor of a single “Multi-face Swap” option to give users more control. However, after discussing this with Runbo, I learned that this approach is significantly more GPU-intensive, since the system has to detect and process each face individually, increasing wait times. In reality, most users were already satisfied with the automatic results from “Swap All Faces,” so requiring them to customize each face introduced unnecessary friction and added complexity without delivering meaningful value.</p>", "single": false}, {"t": "box", "w": 819, "h": 439, "kids": [{"t": "img", "w": 819, "h": 439, "src": "/images/cs/G3rhpYDRz6A7RhNekx6gdUaDs.webp", "fit": "cover", "pos": "50% 50%", "fill": 1}]}, {"t": "text", "w": 600, "h": 204, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Since it was still important to distinguish between “Swap All Faces” and “Multi-face Swap,” I started exploring better ways to communicate what the “Multi-face Swap” feature actually does. Many platforms with similar tools use the term “Multi-face Swap,” and while Nielsen’s fourth heuristic encourages following established conventions, that label isn’t widely adopted yet. Most of our users are novice video editors, and the phrase itself isn’t immediately clear to them.</p><p style=\"margin-top:15px;font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">I brainstormed several alternatives, including “<em style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);font-style:italic;letter-spacing:-0.3px\">Custom Face Swap</em>” and “<em style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);font-style:italic;letter-spacing:-0.3px\">Advanced Face Swap</em>,” but eventually chose a more straightforward, instructional label: “<strong style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);font-weight:700;letter-spacing:-0.3px\">Swap a specific face</strong>.” Even though there still isn’t a standardized term for this function, this instructional phrasing does a better job of guiding users through the intended workflow.</p>", "single": false}, {"t": "box", "w": 819, "h": 439, "flex": "column|10px|0px|center|center|nowrap", "kids": [{"t": "box", "w": 819, "h": 439, "kids": [{"t": "img", "w": 819, "h": 439, "src": "/images/cs/A7DyJf5Uu60SEkGYSwwEI3Srx0c.webp", "fit": "cover", "pos": "50% 50%", "fill": 1}]}], "fill": 1}], "fill": 1}], "fill": 1}, {"reveal": 1, "t": "box", "w": 819, "h": 672, "flex": "column|32px|0px|center|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 819, "h": 672, "flex": "column|8px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"id": "05-solution", "t": "text", "w": 819, "h": 21, "html": "<h5 style=\"font-family:var(--mono);font-size:14px;line-height:21px;color:rgb(82, 4, 254)\">SOLUTION</h5>", "fill": 1, "single": true}, {"t": "text", "w": 819, "h": 38, "html": "<h3 style=\"font-family:var(--serif);font-size:24px;line-height:30px;color:rgb(0, 0, 0)\">The final prototype</h3>", "fill": 1, "single": true}, {"t": "text", "w": 600, "h": 42, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">This user flow is ready for development and is on track to being deployed within the next few weeks! I'm excited to receive more user testings and potentially refine my design!</p>", "single": false}, {"br": "5px", "t": "box", "w": 819, "h": 547, "clip": 1, "kids": [{"abs": [0, 0], "t": "iframe", "w": 819, "h": 547, "src": "https://www.youtube.com/embed/6kbk_XtxXQ8?v=6kbk_XtxXQ8&t=5s&iv_load_policy=3&rel=0&modestbranding=1&playsinline=1&autoplay=1&mute=1&loop=1&playlist=6kbk_XtxXQ8&color=white", "fill": 1}], "fill": 1, "frame": 1}], "fill": 1}], "fill": 1}, {"reveal": 1, "t": "box", "w": 819, "h": 407, "flex": "column|0px|0px|center|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 819, "h": 407, "flex": "column|8px|0px|center|center|nowrap", "clip": 1, "kids": [{"id": "06-reflection", "t": "text", "w": 819, "h": 21, "html": "<h5 style=\"font-family:var(--mono);font-size:14px;line-height:21px;color:rgb(82, 4, 254)\">REFLECTION</h5>", "fill": 1, "single": true}, {"t": "box", "w": 819, "h": 211, "flex": "column|10px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "box", "w": 819, "h": 211, "flex": "column|8px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 600, "h": 68, "html": "<h3 style=\"font-family:var(--serif);font-size:24px;line-height:30px;color:rgb(0, 0, 0)\">Conduct user testing to identify the problem, or find specific information</h3>", "single": false}, {"t": "text", "w": 600, "h": 135, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">Finding a balance between making changes and conducting user tests was very important. It was easy to want to validate every small design decision I made, but conducting user tests takes a lot of time and resources ultimately slowing down the entire design process. At a startup like Magic Hour, designs must be executed quickly so I found myself making a mental note of when I should best conduct user tests, and make small tweaks between each tester.</p>", "single": false}], "fill": 1}], "fill": 1}, {"t": "box", "w": 819, "h": 159, "flex": "column|8px|0px|flex-start|center|nowrap", "clip": 1, "kids": [{"t": "text", "w": 600, "h": 38, "html": "<h3 style=\"font-family:var(--serif);font-size:24px;line-height:30px;color:rgb(0, 0, 0)\">Copy has massive impact on success rates and retention</h3>", "single": true}, {"t": "text", "w": 600, "h": 113, "html": "<p style=\"font-family:var(--sans);font-size:15px;line-height:22.5px;color:rgb(77, 77, 77);letter-spacing:-0.3px\">The confusion caused by the term \"multi-face swap\" was a challenging problem to handle. It was the first time I concretely and immediately felt the impacts of sub-optimized terminology and content design. I had a lot of fun diving into content design principles, and referred to Andy Welfle and Michael J. Metts' book \"Writing is Designing\" as a frame of reference.</p>", "single": false}], "fill": 1}], "fill": 1}], "fill": 1}]}, "accent": "rgb(82, 4, 254)"}