---
import type { Project } from '../data/projects';
interface Props { project: Project }
const { project } = Astro.props;
---
<a class="card" href={project.href} data-cursor={project.href.startsWith("http") ? "link" : undefined} style={`--grow:${project.width}`}>
  <div class="media">
    <img src={project.image} alt="" loading="lazy" decoding="async" />
  </div>
  <h3 class="t-card-title">{project.title}</h3>
  <p class="t-meta">{project.meta}</p>
</a>

<style>
  .card { flex: var(--grow) 1 0; min-width: 0; display: block; }
  .media {
    height: 300px;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 8px;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease);
  }
  @media (hover: hover) {
    .card:hover img { transform: scale(1.1); }
  }
  @media (max-width: 809px) {
    .media { height: auto; aspect-ratio: 547 / 300; }
  }
</style>
